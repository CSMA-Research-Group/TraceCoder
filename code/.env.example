# Apply these explicitly in the server's process environment (not in the browser).
# The server does not automatically read .env files.
TRACECODER_API_BASE=https://your-provider.example/v1
TRACECODER_MODEL=your-model-name
TRACECODER_API_KEY=
TRACECODER_MAX_OUTPUT_TOKENS=4096
TRACECODER_API_TIMEOUT=90
TRACECODER_ACCESS_TOKEN=
TRACECODER_SANDBOX_IMAGE=tracecoder-sandbox:1

# Persistent state: defaults to ../data; do not share between service processes.
# TRACECODER_STATE_DIR=/var/lib/tracecoder
TRACECODER_WORKERS=2
TRACECODER_QUEUE_LIMIT=6
