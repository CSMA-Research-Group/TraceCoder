# Put inside your HTTPS virtual host. Keep the existing TLS configuration.
# For the static teaching deployment, reverse-proxy the compose port.
location / {
    proxy_pass http://127.0.0.1:8765;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # The app limits by peer IP and deliberately ignores untrusted forwarded IPs.
    # Configure nginx per-client rate limits in your HTTPS server if needed.
    proxy_read_timeout 100s;
    proxy_connect_timeout 5s;
    proxy_send_timeout 100s;
    proxy_buffering on;
    proxy_hide_header X-Powered-By;
    client_max_body_size 250k;
}
